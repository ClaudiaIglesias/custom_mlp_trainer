#:kivy 1.9.1



<LayoutMenu>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 1, 0, 0, 1  # red
        Rectangle:
            pos: self.pos
            size: self.size

    width: self.parent.width  # important!
    height: 50


    BoxLayout:
        id:idBoxLayoutMenu
        spacing:5
        orientation: 'horizontal'
#         size: self.parent.size

        pos: self.parent.pos
        width: self.parent.width  # important!

        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.05, 1
            Rectangle:
                pos: self.pos
                size: self.size

<LayoutNeuronMainScreen>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 0, 0.2, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 1, 1  # blue
            Rectangle:
                pos: self.pos
                size: self.size

        orientation: 'vertical'
        size: self.parent.size
        pos: self.parent.pos


<LayoutNeuron>:
    id:idLayoutNeuron
    AnchorLayout:
        id:idAnchorLayoutNeuron
        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.05, 1
            Rectangle:
                pos: self.pos
                size: self.size
        width: self.parent.width  # important!
        height: 600
        anchor_x: 'center'
        anchor_y: 'center'
        LayoutNeuronMainScreen:
            id:idLayoutNeuronMainScreen
            size: 600, 400

<LayoutScreen>:
    id:idLayoutScreen

    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.05, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id:idBoxLayoutScreen
        orientation: 'vertical'
        size: self.parent.size  # important!
        pos: self.parent.pos  # important!

        LayoutNeuron:
            id:idLayoutNeuron

        BoxLayout:
            id:mainseparator
            size_hint: None, None
            width: self.parent.width
            height: 4
            canvas:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        LayoutMenu:
            id:idLayoutMenu


<MyApp>:
    BoxLayout:
        orientation: 'vertical'
        LayoutScreen:
