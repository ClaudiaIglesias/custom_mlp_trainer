#:kivy 1.9.1



<LayoutMenu>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 1, 0, 0, 0  # red
        Rectangle:
            pos: self.pos
            size: self.size

    width: self.parent.width  # important!
    height: 50


    BoxLayout:
        id:idBoxLayoutMenu
        spacing:5
        orientation: 'horizontal'
#         size: self.parent.size

        pos: self.parent.pos
        width: self.parent.width  # important!
        canvas:
            Color:
                rgba: .07,.07,.07,1
            Rectangle:                     #La barra de abajo donde están los plus less btns
                pos: self.pos
                size: self.size
                #source: 'background.png'

<LayoutNeuronMainScreen>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 0.07, 0.07, 0.07, 0
        Rectangle:                      #Dnd están los rectángulos
            pos: self.pos
            size: self.size
            #source: 'background.png'

    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        size: self.parent.size
        BoxLayout:
            width: self.parent.width
            size_hint: None, 0.095
            canvas:
                Color:
                    rgba: 0.05, 0.05, 0.05, 0
                Rectangle:
                    pos: self.pos
                    size: self.size
            RelativeLayout:
                id:idLabelsLayoutNeuronMainScreen
                size_hint:None, None
                size: self.parent.size


        BoxLayout:
            id:idSeparatorLayoutNeuronMainScreen
            size_hint: None, 0.005

            width: self.parent.width
            height: 10
            Image:
                source:'line.png'
                width: self.parent.width

        RelativeLayout:
            id: idrelativelayoutneuronmainscreen
            size_hint: None, 0.9
            width: self.parent.width


<LayoutNeuron>:
    id:idLayoutNeuron
    width: self.parent.width
    AnchorLayout:
        id:idAnchorLayoutNeuron
        canvas.before:
            Color:
                rgba: 0,0,0, 1
            Rectangle:                               #El fondo de everything
                pos: self.pos
                size: self.size
                #source: 'background.png'
        width: self.parent.width  # important!
        height: 600
        anchor_x: 'center'
        anchor_y: 'center'

        LayoutNeuronMainScreen:
            id:idLayoutNeuronMainScreen
            size: 800, 580



<LayoutScreen>:
    id:idLayoutScreen

    canvas.before:
        Color:
            rgba: 0,0,0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id:idBoxLayoutScreen
        orientation: 'vertical'
        size: self.parent.size  # important!
        pos: self.parent.pos  # important!

        BoxLayout:
            orientation: 'horizontal'
            BoxLayout:
                id: idboxlayoutleft                     #Layout left
                orientation: 'vertical'
                size_hint_x: 0.2
                canvas.before:
                    Color:
                        rgba: 0,0,0, 0
                    Rectangle:
                        pos: self.pos
                        size: self.size
                BoxLayout:
                    id: idlayouttop
                    orientation: 'horizontal'
                    spacing: 15
                    size_hint: (1,.15)
                    pos_hint: {'center_x':.5, 'center_y':.5}
                BoxLayout:
                    id: idlayoutmiddle
                    orientation: 'vertical'
                    size_hint: (.9,.70)
                    pos_hint: {'center_x':.5, 'center_y':.5}
                    #Label:
                        #text: '[b] File: [/b][i]'
                        #markup: True
                        #pos_hint: {'center_x': .5, 'center_y': 0}
                        #size_hint: (1, .1)
                BoxLayout:
                    id: idlayoutdown
                    orientation: 'vertical'
                    spacing: 10
                    size_hint: (1,.05)
                BoxLayout:
                    id: idlayoutlbldown
                    orientation: 'horizontal'
                    spacing: 10
                    size_hint: (1,.1)
            LayoutNeuron:
                id:idLayoutNeuron
                size_hint_x: 0.6

            BoxLayout:
                id: idboxlayoutright
                size_hint_x: 0.2                   #Info right
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0
                    Rectangle:
                        pos: self.pos
                        size: self.size
                BoxLayout:
                    id: idlayoutrightmiddle
                    orientation: 'vertical'
                    size_hint: (.9,.9)
                    pos_hint: {'center_x':.5, 'center_y':.5}
                BoxLayout:
                    id: idlayoutrightdown
                    orientation: 'vertical'
                    spacing: 10
                    size_hint: (1,.1)




        BoxLayout:
            id:mainseparatorprogressbar
            size_hint: None, None
            width: self.parent.width
            height: 2
            canvas:
                Color:
                    rgba: 0, 0, 0, 0
                Rectangle:
                    pos: self.pos
                    size: self.size


        BoxLayout:
            id:mainseparator
            size_hint: None, None
            width: self.parent.width
            height: 2
            canvas:
                Color:
                    rgba: .7,.7,.7,1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    #source: 'lineaD.png'

        BoxLayout:
            id:mainseparator2
            size_hint: None, None
            width: self.parent.width
            height: 2
            canvas:
                Color:
                    rgba: 0, 0, 0, 0
                Rectangle:
                    pos: self.pos
                    size: self.size

        LayoutMenu:
            id:idLayoutMenu



<Filechooser>:
    id: idfilechooser
    BoxLayout:
        orientation:'vertical'
        FileChooserIconView:
            id: filechooserbox
            path: '.'
            on_selection: text_input.text = self.selection and self.selection[0] or ''
            #on_selection: idfilechooser.selected(filechooserbox.selection)


        BoxLayout:
            orientation: 'horizontal'
            size_hint: None,.065
            width: self.parent.width
            TextInput:
                id: text_input
                size_hint_y: None
                height: 30
                multiline: False
                pos_hint: {'center_x': .5, 'center_y': .5}
            Button:
                text: 'Cancel'
                on_press: idfilechooser.popupdismiss()
                size_hint_x: .2
                pos_hint: {'center_x': .5, 'center_y': .5}
                background_normal: 'ButtonPlusP.png'
                background_down: 'ButtonDeactivated.png'
            Button:
                text: 'Open'
                on_press: idfilechooser.open(filechooserbox.path, text_input.text)
                size_hint_x: .2
                pos_hint: {'center_x': .5, 'center_y': .5}
                background_normal: 'ButtonPlusB.png'
                background_down: 'ButtonDeactivated.png'
                color: 0,0,0,1



<MyApp>:
    BoxLayout:
        orientation: 'vertical'
        LayoutScreen:
