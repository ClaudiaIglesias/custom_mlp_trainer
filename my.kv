#:kivy 1.9.1



<LayoutMenu>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 1, 0, 0, 1  # red
        Rectangle:
            pos: self.pos
            size: self.size

    width: self.parent.width  # important!
    height: 50


    BoxLayout:
        id:idBoxLayoutMenu
        spacing:5
        orientation: 'horizontal'
#         size: self.parent.size

        pos: self.parent.pos
        width: self.parent.width  # important!
        canvas:
            Color:
                rgba: .1,.1,.1,1
            Rectangle:                     #La barra de abajo donde están los plus less btns
                pos: self.pos
                size: self.size
                source: 'background.jpeg'

<LayoutNeuronMainScreen>:
    size_hint: None, None
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:                      #Dnd están los rectángulos
            pos: self.pos
            size: self.size
            source: 'background.png'

    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        size: self.parent.size
        BoxLayout:
            width: self.parent.width
            size_hint: None, 0.095
            canvas:
                Color:
                    rgba: 0.05, 0.05, 0.05, 0
                Rectangle:
                    pos: self.pos
                    size: self.size
            RelativeLayout:
                id:idLabelsLayoutNeuronMainScreen
                size_hint:None, None
                size: self.parent.size


        BoxLayout:
            id:idSeparatorLayoutNeuronMainScreen
            size_hint: None, 0.005

            width: self.parent.width
            height: 10
            Image:
                source:'line.png'
                width: self.parent.width

        RelativeLayout:
            id: idrelativelayoutneuronmainscreen
            size_hint: None, 0.9
            width: self.parent.width





<LayoutNeuron>:
    id:idLayoutNeuron
    AnchorLayout:
        id:idAnchorLayoutNeuron
        canvas.before:
            Color:
                rgba: .2, .2, .2, 1
            Rectangle:                               #El fondo de everything
                pos: self.pos
                size: self.size
                source: 'background.png'
        width: self.parent.width  # important!
        height: 600
        anchor_x: 'center'
        anchor_y: 'center'


        LayoutNeuronMainScreen:
            id:idLayoutNeuronMainScreen
            size: 800, 580

<LayoutScreen>:
    id:idLayoutScreen

    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.05, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id:idBoxLayoutScreen
        orientation: 'vertical'
        size: self.parent.size  # important!
        pos: self.parent.pos  # important!

        LayoutNeuron:
            id:idLayoutNeuron

        BoxLayout:
            id:mainseparatorprogressbar
            size_hint: None, None
            width: self.parent.width
            height: 2
            canvas:
                Color:
                    rgba: 0, 0, 0, 0
                Rectangle:
                    pos: self.pos
                    size: self.size


        BoxLayout:
            id:mainseparator
            size_hint: None, None
            width: self.parent.width
            height: 1
            canvas:
                Color:
                    rgba: 1, 1,1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    source: 'linea.png'

        BoxLayout:
            id:mainseparator2
            size_hint: None, None
            width: self.parent.width
            height: 2
            canvas:
                Color:
                    rgba: 0, 0, 0, 0
                Rectangle:
                    pos: self.pos
                    size: self.size

        LayoutMenu:
            id:idLayoutMenu


<MyApp>:
    BoxLayout:
        orientation: 'vertical'
        LayoutScreen:
